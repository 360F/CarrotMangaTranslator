{
  "name": "rovercmt-renderer-comparison-spike",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated renderer comparison harness for immutable RoverCMT fixtures",
  "scripts": {
    "build": "esbuild src/shared-layout.ts --bundle --platform=node --format=cjs --target=node20 --outfile=lib/shared-layout.cjs",
    "compare": "npm run build && node src/run-comparison.cjs",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "canvas": "3.2.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "skia-canvas": "3.0.8"
  }
}
